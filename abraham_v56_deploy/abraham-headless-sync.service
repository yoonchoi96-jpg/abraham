[Unit]
Description=Obsidian Headless Sync for Abraham Vault
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=abraham
Group=abraham
WorkingDirectory=/opt/abraham/vault
Environment=HOME=/home/abraham
ExecStart=/usr/bin/ob sync --path /opt/abraham/vault --continuous
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
