# Abraham V5.6 production configuration
GEMINI_API_KEY=
MODEL=gemini-3.1-flash-lite

# Linux VM paths
ABRAHAM_DB_PATH=/opt/abraham/data/abraham.db
ABRAHAM_VAULT_PATH=/opt/abraham/vault
ABRAHAM_REPORT_DIR=/opt/abraham/reports
ABRAHAM_KOREAN_CACHE_PATH=/opt/abraham/reports/korean_presentation_cache_v50.json
ABRAHAM_LOG_DIR=/opt/abraham/reports/logs

KOREAN_BATCH_SIZE=20
KOREAN_MAX_RETRIES=3
ABRAHAM_SCHEDULE_KST=00:00,03:00,06:00,09:00,12:00,15:00,18:00,21:00

# Optional: a mounted backup target such as MYBOX mount path.
# Leave empty to keep backups under ABRAHAM_BACKUP_PATH.
ABRAHAM_EXTERNAL_BACKUP_PATH=

# V5.6 Storage Lifecycle
ABRAHAM_BACKUP_PATH=/opt/abraham/backups
ABRAHAM_ARCHIVE_PATH=/opt/abraham/archive
ABRAHAM_STORAGE_WARN_PCT=80
ABRAHAM_STORAGE_CRITICAL_PCT=90
ABRAHAM_BACKUP_RETENTION=14
ABRAHAM_REPORT_RETENTION_DAYS=30
ABRAHAM_LOG_RETENTION_DAYS=14
ABRAHAM_BACKUP_COMPRESS_DAYS=2
