# Abraham V5.6
DEEPSEEK_API_KEY=
MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_RATING_MODEL=gemini-3.6-flash

# Local paths
ABRAHAM_VAULT_PATH=
ABRAHAM_DB_PATH=
ABRAHAM_REPORT_DIR=

# Optional runtime tuning
KOREAN_BATCH_SIZE=20
KOREAN_MAX_RETRIES=3

# KST schedule
ABRAHAM_SCHEDULE_KST=00:00,09:00,17:00

# GitHub Actions / Obsidian Headless Sync secrets (configure in GitHub Actions Secrets)
READWISE_TOKEN=
OBSIDIAN_AUTH_TOKEN=
OBSIDIAN_VAULT_NAME=
OBSIDIAN_SYNC_PASSWORD=
